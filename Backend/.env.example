OPENAI_API_KEY=your_openai_api_key_here
# Recommended: gpt-4o (best research + Hebrew quality, ~$0.0025/1K input tokens)
# Budget option: gpt-4o-mini (~$0.00015/1K input tokens, weaker reasoning)
OPENAI_MODEL=gpt-4o
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=chatproj_db
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Port the backend listens on (default: 8001)
PORT=8001
